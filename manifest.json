{
  "name": "Busy Bee Pro",
  "short_name": "Busy Bee",
  "description": "Personal productivity suite: lists, notes, JSON tools, FreshDesk/JIRA/Twilio analytics, a Markdown viewer, and a world clock — all in one offline-capable app.",
